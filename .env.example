# PICTOART Environment Configuration
# Copy this file to .env and update values before running.

# --- Application ---
APP_NAME=PICTOART - Doctor Pencil Sketch Certificate Generator
ENV=development
DEBUG=True
SECRET_KEY=change-this-to-a-random-secret-string-at-least-64-chars-long
BASE_URL=http://localhost:8000

# --- Database ---
# Local SQLite (default for development)
DATABASE_URL=sqlite:///./pictoart.db
# PostgreSQL example (for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/pictoart

# --- File Storage ---
STORAGE_DIR=./storage
# Set to True and provide credentials to use Cloudflare R2 / S3:
USE_S3_STORAGE=False
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_r2_access_key
S3_SECRET_ACCESS_KEY=your_r2_secret_key
S3_BUCKET_NAME=pictoart-certificates

# --- Background Worker ---
# 'threaded' = background threads (default, no Redis required for local dev)
# 'rq'       = Redis Queue (recommended for production, run: python cli.py run-worker)
WORKER_MODE=threaded
REDIS_URL=redis://localhost:6379/0

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=10
