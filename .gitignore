# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
ENV/

# Environment variables & secrets
.env

# SQLite Databases & Local runtime state
*.db
*.sqlite
*.sqlite3

# File Storage (ignore uploaded photos & generated art, preserve directory structure)
storage/originals/*
storage/generated/*
storage/exports/*
!storage/originals/.gitkeep
!storage/generated/.gitkeep
!storage/exports/.gitkeep
debug_output/

# Temporary test & debug images
doctor_*.jpg
sample_sketch_output.png

# Node / NPM (Python project)
node_modules/
package.json
package-lock.json
